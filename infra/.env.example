# Template. Copy to .env.local (local dev) or .env (production), both git-ignored.
#   local: docker compose --env-file .env.local up -d
#   prod:  docker compose up -d        (reads .env)
# In production use a strong random password, never this one.
POSTGRES_DB=englishprep
POSTGRES_USER=root
POSTGRES_PASSWORD=12345
POSTGRES_PORT=5432
